<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><script>window.CFG={f:'n4nnm3pj5bdd7b',k:'k2'}</script>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Star Chores</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#fff8e7;--card:#fff;--ink:#2b2540;--mute:#7a7490;--line:#eadfc4;--acc:#f5a623;--ok:#d9f5df;--okink:#1d6b34;--bad:#e5484d}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#1d1a2b;--card:#2a2640;--ink:#f3efff;--mute:#a49fbd;--line:#3d3860;--ok:#1f4a2c;--okink:#a8f0bb}}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.35 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;min-height:100vh}
#app{max-width:980px;margin:0 auto;padding:14px}
h1,h2,h3{margin:.3em 0}
button{font:inherit;color:inherit;cursor:pointer;border:2px solid var(--line);background:var(--card);border-radius:16px;padding:10px 16px;min-height:48px}
button.pri{background:var(--acc);border-color:var(--acc);color:#2b2540;font-weight:700}
button.dng{color:var(--bad);border-color:var(--bad)}
input,select{font:inherit;color:inherit;background:var(--card);border:2px solid var(--line);border-radius:12px;padding:8px 10px;min-height:44px;max-width:100%}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.homegrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:20px}
.kidcard{border:4px solid var(--kc);border-radius:28px;padding:26px 10px;text-align:center;background:var(--card);min-height:260px}
.kidcard .av{font-size:96px;line-height:1}.kidcard .nm{font-size:34px;font-weight:800}.kidcard .bal{font-size:30px;margin-top:6px}
.bar{display:flex;align-items:center;gap:12px;background:var(--kc);color:#fff;border-radius:24px;padding:10px 18px;margin-bottom:14px}
.bar .big{font-size:38px;font-weight:800;margin-left:auto}.bar .av{font-size:46px}.bar .nm{font-size:28px;font-weight:800}
.bar button{min-height:44px}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.tile{position:relative;border:3px solid var(--line);border-radius:22px;background:var(--card);text-align:center;padding:12px 6px;min-height:170px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:4px}
.tile .e{font-size:60px;line-height:1.05}.tile .t{font-weight:700;font-size:17px}.tile .s{font-size:19px}
.tile:active{transform:scale(.96)}
.tile.done{background:var(--ok);border-color:var(--okink);color:var(--okink);opacity:.85}
.tile .chk{position:absolute;top:4px;right:8px;font-size:30px}
.tile .cnt{position:absolute;top:6px;right:10px;background:var(--acc);color:#2b2540;border-radius:999px;font-weight:800;padding:0 10px}
.goals{margin-top:20px}.goal{display:flex;align-items:center;gap:10px;margin:8px 0}
.goal .p{flex:1;height:18px;background:var(--line);border-radius:99px;overflow:hidden}.goal .p i{display:block;height:100%;background:var(--acc)}
.panel{background:var(--card);border:2px solid var(--line);border-radius:20px;padding:14px;margin-bottom:14px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}.tabs button.on{background:var(--acc);border-color:var(--acc);color:#2b2540;font-weight:700}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:8px 0}
.row input[type=number]{width:84px}.row .em{width:64px;text-align:center;font-size:24px}.row .nm{flex:1;min-width:150px}
.hist{font-size:15px;border-top:1px solid var(--line);padding:6px 0;display:flex;gap:8px;align-items:center}.hist span:nth-child(2){flex:1}
.mute{color:var(--mute);font-size:15px}.plus{color:var(--okink)}.minus{color:var(--bad)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:20px;z-index:20}
.modal .box{background:var(--card);border-radius:22px;padding:22px;max-width:340px;width:100%;text-align:center}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#2b2540;color:#fff;padding:12px 22px;border-radius:99px;font-size:22px;z-index:30}
.fly{position:fixed;font-size:44px;pointer-events:none;z-index:40;animation:fly 1s ease-out forwards}
@keyframes fly{to{transform:translateY(-160px) scale(1.6);opacity:0}}
textarea{width:100%;min-height:90px;font:13px monospace;background:var(--card);color:var(--ink);border:2px solid var(--line);border-radius:12px}
</style></head><body><div id="app"></div>
<script>
const KEY='starchores.v1';
const DEF={kids:[{id:'k1',name:'Big Kid',e:'🦊',c:'#3b82f6'},{id:'k2',name:'Little Kid',e:'🐼',c:'#d946ef'}],
chores:[
['🐕','Feed the dog (morning)',1,'shared'],['🌙','Feed the dog (evening)',1,'shared'],['🍽️','Empty the dishwasher',2,'shared'],['🥣','Put dishes in dishwasher',1,'shared'],['💩','Pick up dog poops',10,'shared'],
['🪥','Brush teeth (morning)',2,'each'],['🛏️','Brush teeth (evening)',2,'each'],['🧸','Tidy your room',3,'each'],['🧹','Clean the basement',5,'shared'],['🎒','Put lunch bag away',2,'each'],['📚','Read a book',1,'repeat'],['🧺','Help put laundry away',3,'shared'],['👟','Put shoes away',1,'each']
].map((a,i)=>({id:'c'+i,e:a[0],n:a[1],s:a[2],t:a[3]})),
rewards:[{id:'r1',e:'🍦',n:'Ice cream trip',cost:40},{id:'r2',e:'🎬',n:'Movie night',cost:60},{id:'r3',e:'🎢',n:'Fun park trip',cost:150}],
log:[],set:{pin:'1234',rate:10}};
DEF.chores[6].e='🌛';
const DB='https://star-chart-2c98a-default-rtdb.firebaseio.com';
const Q=new URLSearchParams(location.search),C=window.CFG||{},FAM=Q.get('f')||C.f,MYKID=Q.get('kid')||C.k;
let S=null,online=true;


const api=async(p,m,b)=>{const r=await fetch(DB.replace(/\/$/,'')+'/fam/'+FAM+p+'.json',{method:m||'GET',body:b===undefined?undefined:JSON.stringify(b)});if(!r.ok)throw 0;return r.json()};
const save=()=>{const {log,...rest}=S;api('','PATCH',rest).catch(()=>toast('Not saved - no internet'))};
const linkFor=k=>location.origin+location.pathname+'?f='+FAM+(k?'&kid='+k:'');
async function sync(){
 try{const d=await api('');
  if(!d){S=JSON.parse(JSON.stringify(DEF));S.log=[];const {log,...rest}=S;await api('','PUT',rest)}
  else S={kids:d.kids||[],chores:d.chores||[],rewards:d.rewards||[],set:d.set||DEF.set,log:Object.entries(d.log||{}).map(([id,l])=>({...l,id})).sort((a,b)=>a.ts-b.ts)};
  online=true}catch(e){online=false}
 if(!S){$('#app').innerHTML='<div class="panel"><b>Can\u2019t reach the internet.</b> Trying again\u2026</div>';return}
 const ae=document.activeElement;if((ae&&/INPUT|TEXTAREA|SELECT/.test(ae.tagName))||ui.modal)return;render()}
let storageOK=true;try{localStorage.setItem('sc-test','1');localStorage.removeItem('sc-test')}catch(e){storageOK=false}
try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist()}catch(e){}
let ui={v:'home',k:null,tab:'pay',modal:null};
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
const uid=()=>Math.random().toString(36).slice(2,9);
const kid=id=>S.kids.find(k=>k.id===id);
const bal=k=>S.log.filter(l=>l.k===k).reduce((a,l)=>a+l.s,0);
const stars=n=>n<=5?'⭐'.repeat(n):'⭐×'+n;
const money=n=>'$'+(Math.round(n*100)/100).toFixed(2);
const doneList=(c,k)=>S.log.filter(l=>l.d===today()&&l.c===c.id&&l.s>0&&(c.t==='shared'||l.k===k));
function add(k,c,s,note){const e={id:uid(),ts:Date.now(),d:today(),k,c:c?c.id:null,s,note:note||''};S.log.push(e);const {id,...rest}=e;api('/log/'+id,'PUT',rest).catch(()=>{S.log=S.log.filter(x=>x.id!==id);toast('No internet - not saved');render()})}
function toast(t){const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),1600)}
function fly(x,y){const d=document.createElement('div');d.className='fly';d.textContent='⭐';d.style.left=x-22+'px';d.style.top=y-22+'px';document.body.appendChild(d);setTimeout(()=>d.remove(),1000)}

function render(){
 if(MYKID&&kid(MYKID)&&ui.v==='home'){ui.v='kid';ui.k=MYKID}
 const a=$('#app');
 if(ui.v==='home')a.innerHTML=home();
 else if(ui.v==='kid')a.innerHTML=kidView();
 else a.innerHTML=parentView();
 if(!online)a.insertAdjacentHTML('afterbegin','<div class="panel" style="border-color:var(--bad)"><b>⚠️ No internet.</b> Stars can’t be saved right now.</div>');
 if(ui.modal==='pin')a.insertAdjacentHTML('beforeend',`<div class="modal"><div class="box"><h2>🔒 Parent PIN</h2><input id="pin" type="password" inputmode="numeric" autocomplete="off" style="font-size:28px;text-align:center;width:100%"><p id="pe" class="minus"></p><div class="row" style="justify-content:center"><button data-a="x">Cancel</button><button class="pri" data-a="unlock">Unlock</button></div></div></div>`),setTimeout(()=>{const p=$('#pin');p&&p.focus()},50);
}
function home(){return `<div class="top"><h1>⭐ Star Chores</h1><button data-a="pin">🔒 Parents</button></div><div class="homegrid">`+S.kids.map(k=>`<div class="kidcard" data-a="kid" data-k="${k.id}" style="--kc:${k.c};cursor:pointer"><div class="av">${k.e}</div><div class="nm">${esc(k.name)}</div><div class="bal">⭐ ${bal(k.id)}</div></div>`).join('')+`</div>`}
function kidView(){
 const k=kid(ui.k),b=bal(k.id);
 let h=`<div class="bar" style="--kc:${k.c}">${!MYKID?'<button data-a="home">⬅ Back</button>':'<button data-a="pin">🔒</button>'}<span class="av">${k.e}</span><span class="nm">${esc(k.name)}</span><span class="big">⭐ ${b}</span></div><div class="tiles">`;
 for(const c of S.chores){
  const dl=doneList(c,k.id),done=c.t!=='repeat'&&dl.length>0;
  let badge='';
  if(done)badge=`<span class="chk">✅</span>`;else if(c.t==='repeat'&&dl.length)badge=`<span class="cnt">×${dl.length}</span>`;
  const who=done&&c.t==='shared'&&dl[0].k!==k.id?` ${kid(dl[0].k)?kid(dl[0].k).e:''}`:'';
  h+=`<button class="tile${done?' done':''}" data-a="do" data-c="${c.id}" ${done?'disabled':''}>${badge}<span class="e">${c.e}</span><span class="t">${esc(c.n)}${who}</span><span class="s">${stars(c.s)}</span></button>`;
 }
 h+=`</div>`;
 if(S.kids.length>1){const mx=Math.max(1,...S.kids.map(x=>bal(x.id)));h+=`<div class="panel goals"><h3>🏆 Star scoreboard</h3>`+S.kids.map(o=>{const t=S.log.filter(l=>l.k===o.id&&l.d===today()&&l.s>0).reduce((a,l)=>a+l.s,0);return `<div class="goal"><span style="font-size:40px">${o.e}</span><div style="flex:1"><b>${esc(o.name)}</b> <span class="mute">today +${t}</span><div class="p"><i style="width:${Math.max(3,bal(o.id)/mx*100)}%;background:${o.c}"></i></div></div><b style="font-size:26px">⭐ ${bal(o.id)}</b></div>`}).join('')+`</div>`;}
 if(S.rewards.length){h+=`<div class="panel goals"><h3>🎁 My goals</h3>`+S.rewards.map(r=>`<div class="goal"><span style="font-size:36px">${r.e}</span><div style="flex:1"><b>${esc(r.n)}</b> <span class="mute">${Math.min(b,r.cost)}/${r.cost} ⭐</span><div class="p"><i style="width:${Math.max(0,Math.min(100,b/r.cost*100))}%"></i></div></div></div>`).join('')+`</div>`}
 return h;
}
function parentView(){
 let h=`<div class="top"><h1>🔒 Parent area</h1><button data-a="home">Lock &amp; exit</button></div><div class="tabs">`+[['pay','💰 Payouts'],['chores','🧹 Chores'],['rew','🎁 Rewards'],['set','⚙️ Settings']].map(t=>`<button data-a="tab" data-t="${t[0]}" class="${ui.tab===t[0]?'on':''}">${t[1]}</button>`).join('')+`</div>`;
 if(ui.tab==='pay'){
  for(const k of S.kids){const b=bal(k.id);
   h+=`<div class="panel"><h2>${k.e} ${esc(k.name)}: ⭐ ${b} <span class="mute">(${money(b/S.set.rate)})</span></h2>
   <div class="row"><b>Cash out</b><input type="number" id="co-${k.id}" min="1" placeholder="stars"><button class="pri" data-a="cash" data-k="${k.id}">Pay out</button><button data-a="cashall" data-k="${k.id}">All (${money(b/S.set.rate)})</button></div>
   <div class="row"><b>Trade for</b>${S.rewards.map(r=>`<button data-a="redeem" data-k="${k.id}" data-r="${r.id}" ${b<r.cost?'disabled':''}>${r.e} ${esc(r.n)} (${r.cost}⭐)</button>`).join('')||'<span class="mute">No rewards yet</span>'}</div>
   <div class="row"><b>Adjust</b><input type="number" id="bn-${k.id}" placeholder="+5 or -5"><button data-a="bonus" data-k="${k.id}">Apply</button></div></div>`}
  h+=`<div class="panel"><h3>Recent activity</h3>`+(S.log.slice(-40).reverse().map(l=>{const c=S.chores.find(x=>x.id===l.c),kk=kid(l.k);return `<div class="hist"><span>${kk?kk.e:'?'}</span><span>${c?c.e+' '+esc(c.n):esc(l.note||'Adjustment')}<br><span class="mute">${l.d}</span></span><b class="${l.s>0?'plus':'minus'}">${l.s>0?'+':''}${l.s}</b><button data-a="undo" data-l="${l.id}" style="min-height:36px;padding:2px 10px">Undo</button></div>`}).join('')||'<span class="mute">Nothing yet.</span>')+`</div>`;
 }
 if(ui.tab==='chores'){
  h+=`<div class="panel"><p class="mute">Each kid daily = every child can earn it once a day. Shared daily = once a day, whoever does it first. Repeatable = unlimited (e.g. books).</p>`+S.chores.map((c,i)=>`<div class="row"><input class="em" data-f="chores.${i}.e" value="${esc(c.e)}"><input class="nm" data-f="chores.${i}.n" value="${esc(c.n)}"><input type="number" min="0" data-f="chores.${i}.s" value="${c.s}"><select data-f="chores.${i}.t">${[['each','Each kid daily'],['shared','Shared daily'],['repeat','Repeatable']].map(o=>`<option value="${o[0]}" ${c.t===o[0]?'selected':''}>${o[1]}</option>`).join('')}</select><button class="dng" data-a="delc" data-i="${i}">✕</button></div>`).join('')+`<button class="pri" data-a="addc">+ Add chore</button></div>`;
 }
 if(ui.tab==='rew'){
  h+=`<div class="panel">`+S.rewards.map((r,i)=>`<div class="row"><input class="em" data-f="rewards.${i}.e" value="${esc(r.e)}"><input class="nm" data-f="rewards.${i}.n" value="${esc(r.n)}"><input type="number" min="1" data-f="rewards.${i}.cost" value="${r.cost}"><span class="mute">stars</span><button class="dng" data-a="delr" data-i="${i}">✕</button></div>`).join('')+`<button class="pri" data-a="addr">+ Add reward</button></div>`;
 }
 if(ui.tab==='set'){
  h+=`<div class="panel"><h3>Kids</h3>`+S.kids.map((k,i)=>`<div class="row"><input class="em" data-f="kids.${i}.e" value="${esc(k.e)}"><input class="nm" data-f="kids.${i}.name" value="${esc(k.name)}"><input type="color" data-f="kids.${i}.c" value="${k.c}" style="width:56px;padding:2px"></div>`).join('')+`</div>
  <div class="panel"><h3>Cash &amp; PIN</h3><div class="row"><span>Stars per $1:</span><input type="number" min="1" data-f="set.rate" value="${S.set.rate}"></div><div class="row"><span>Parent PIN:</span><input data-f="set.pin" value="${esc(S.set.pin)}" inputmode="numeric"></div></div>
  <div class="panel"><h3>Tablet links</h3><p class="mute">Open each link on that child’s tablet and add it to the home screen. Keep these private.</p>${S.kids.map(k=>`<p>${k.e} ${esc(k.name)}:<br><input readonly style="width:100%;font-size:13px" value="${linkFor(k.id)}"></p>`).join('')}<p>Parent link (both kids):<br><input readonly style="width:100%;font-size:13px" value="${linkFor('')}"></p><button class="dng" data-a="reset">Erase all stars</button></div>`;
 }
 return h;
}
function setPath(p,v){const a=p.split('.');let o=S;for(let i=0;i<a.length-1;i++)o=o[a[i]];const l=a[a.length-1];o[l]=(typeof o[l]==='number')?(parseInt(v)||0):v}
document.addEventListener('change',e=>{const f=e.target.dataset&&e.target.dataset.f;if(!f)return;setPath(f,e.target.value);save();if(/^set\.|^kids\./.test(f))render()});
document.addEventListener('click',e=>{
 const el=e.target.closest('[data-a]');if(!el)return;const d=el.dataset,a=d.a;
 if(a==='kid'){ui.v='kid';ui.k=d.k}
 else if(a==='home'){ui.v='home';ui.modal=null}
 else if(a==='pin'){ui.modal='pin'}
 else if(a==='x'){ui.modal=null}
 else if(a==='unlock'){if($('#pin').value===S.set.pin){ui.modal=null;ui.v='parent'}else{$('#pe').textContent='Wrong PIN';return}}
 else if(a==='do'){const c=S.chores.find(x=>x.id===d.c);if(c.t!=='repeat'&&doneList(c,ui.k).length)return;add(ui.k,c,c.s);const r=el.getBoundingClientRect();fly(r.left+r.width/2,r.top+30);toast('+'+c.s+' ⭐ Great job!')}
 else if(a==='tab')ui.tab=d.t;
 else if(a==='cash'||a==='cashall'){const b=bal(d.k);let n=a==='cashall'?b:parseInt($('#co-'+d.k).value);if(!n||n<1||n>b){toast('Check the amount');return}add(d.k,null,-n,'Cash '+money(n/S.set.rate));toast('Pay '+money(n/S.set.rate))}
 else if(a==='redeem'){const r=S.rewards.find(x=>x.id===d.r);if(bal(d.k)<r.cost)return;add(d.k,null,-r.cost,r.e+' '+r.n);toast('Enjoy! '+r.e)}
 else if(a==='bonus'){const n=parseInt($('#bn-'+d.k).value);if(!n)return;add(d.k,null,n,'Adjustment')}
 else if(a==='undo'){S.log=S.log.filter(l=>l.id!==d.l);api('/log/'+d.l,'DELETE').catch(()=>toast('Not saved'))}
 else if(a==='addc'){S.chores.push({id:'c'+uid(),e:'⭐',n:'New chore',s:1,t:'each'});save()}
 else if(a==='delc'){if(confirm('Delete this chore?')){S.chores.splice(+d.i,1);save()}}
 else if(a==='addr'){S.rewards.push({id:'r'+uid(),e:'🎁',n:'New reward',cost:50});save()}
 else if(a==='delr'){S.rewards.splice(+d.i,1);save()}
 else if(a==='restore'){try{const j=JSON.parse($('#bk').value);if(!j.kids||!j.chores)throw 0;S=j;save();toast('Restored')}catch(x){toast('Backup not valid')}}
 else if(a==='reset'){if(confirm('Erase all stars and history?')){S.log=[];api('/log','DELETE').catch(()=>toast('Not saved'));ui.modal=null}}
 render();
});
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&ui.modal==='pin')document.querySelector('[data-a="unlock"]').click()});
function boot(){const a=$('#app');
 if(DB.indexOf('http')!==0){a.innerHTML='<div class="panel"><h2>Almost there</h2><p>The database address hasn’t been added to this file yet.</p></div>';return}
 if(!FAM){const c=Array.from(crypto.getRandomValues(new Uint8Array(14)),b=>'abcdefghjkmnpqrstuvwxyz23456789'[b%31]).join('');a.innerHTML=`<div class="panel"><h2>⭐ Set up your family</h2><p>A secret code keeps your family’s data private. Tap below, then save the new page’s address.</p><p><a href="?f=${c}" style="font-size:24px;font-weight:700">Start my family</a></p></div>`;return}
 a.innerHTML='<p class="mute">Loading…</p>';sync();setInterval(sync,6000)}
boot();
</script></body></html>
